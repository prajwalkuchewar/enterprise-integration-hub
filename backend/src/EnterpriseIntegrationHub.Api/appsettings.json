{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Outbox": {
    "Enabled": false,
    "BatchSize": 25,
    "PollIntervalSeconds": 2,
    "LeaseSeconds": 60,
    "MaxAttempts": 8,
    "BaseRetryDelaySeconds": 2,
    "MaxRetryDelaySeconds": 300
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "eih-api",
    "ExecutionDispatchTopic": "eih.execution.dispatch.v1",
    "MessageTimeoutMs": 30000
  }
}
